# Model configuration
BASE_MODEL_PATH="microsoft/BitNet-b1.58-27B"
LORA_ADAPTER_PATH="./consolidated_slow_lora"
DEVICE="cuda"
USE_MOCK=false
SMALL_MODEL=false

# Reasoning & Search settings
ENTROPY_LOW_THRESHOLD=0.25
ENTROPY_HIGH_THRESHOLD=0.70
PRO_BRANCH_COUNT_DEFAULT=16
INSTANT_BRANCH_COUNT=1
SEARCH_TEMPERATURE=0.75
SEARCH_TOP_P=0.92
MAX_NEW_TOKENS=1536
PRM_PRUNING_THRESHOLD=0.40

# Sandbox verification
SANDBOX_TIMEOUT_SECONDS=4.0
USE_DOCKER_SANDBOX=false
DOCKER_IMAGE="python:3.10-slim"

# Memory & Consolidation
DATABASE_PATH="memory.db"
EWC_LAMBDA=400.0
CONSOLIDATION_LR=0.00002
CONSOLIDATION_WEIGHT_DECAY=0.01
EPISODIC_REPLAY_RATIO=0.25
IDLE_SLEEP_THRESHOLD_MINUTES=30
